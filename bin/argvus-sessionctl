#!/usr/bin/env sh
# shellcheck disable=SC1091
# Control the ARGVUS graphical session lifecycle.

set -eu

SYSTEM_CONFIG="${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}"
CONFIG_HOME="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/argvus"
LOG="$STATE_DIR/session.log"

log() {
  mkdir -p "$STATE_DIR"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}

warn() {
  printf 'argvus-sessionctl: %s\n' "$*" >&2
}

have() {
  command -v "$1" >/dev/null 2>&1
}

user_systemd_available() {
  have systemctl && systemctl --user show-environment >/dev/null 2>&1
}

unit_exists() {
  user_systemd_available || return 1
  systemctl --user cat "$1" >/dev/null 2>&1
}

import_environment() {
  export ARGVUS_CONFIG_HOME="$CONFIG_HOME"
  export ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG"
  export XDG_CONFIG_HOME="$CONFIG_HOME"
  case ":${XDG_CONFIG_DIRS:-/etc/xdg}:" in
    *":$SYSTEM_CONFIG:") ;;
    *) export XDG_CONFIG_DIRS="$SYSTEM_CONFIG:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
  esac
  export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
  export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"
  export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
  export DESKTOP_SESSION="${DESKTOP_SESSION:-argvus}"
  export GDMSESSION="${GDMSESSION:-argvus}"
  export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
  export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-qt6ct}"
  export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-org.hyprland.style}"

  if user_systemd_available; then
    systemctl --user import-environment \
      ARGVUS_CONFIG_HOME ARGVUS_SYSTEM_CONFIG \
      XDG_CONFIG_HOME XDG_CONFIG_DIRS XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
      XDG_SESSION_TYPE DESKTOP_SESSION GDMSESSION WAYLAND_DISPLAY DISPLAY \
      XDG_CURRENT_DESKTOP XDG_SESSION_CLASS XDG_SESSION_ID XDG_VTNR \
      XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD \
      ARGVUS_VIRTUALIZATION ARGVUS_LOW_POWER LIBGL_ALWAYS_SOFTWARE WLR_RENDERER_ALLOW_SOFTWARE \
      WLR_NO_HARDWARE_CURSORS AQ_NO_MODIFIERS \
      QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_STYLE \
      XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_SIZE \
      MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT SDL_VIDEODRIVER \
      _JAVA_AWT_WM_NONREPARENTING SAL_USE_VCLPLUGIN YAZI_CONFIG_HOME \
      DBUS_SESSION_BUS_ADDRESS >/dev/null 2>&1 || true
  fi

  if have dbus-update-activation-environment; then
    dbus-update-activation-environment --systemd \
      ARGVUS_CONFIG_HOME ARGVUS_SYSTEM_CONFIG \
      XDG_CONFIG_HOME XDG_CONFIG_DIRS XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
      XDG_SESSION_TYPE DESKTOP_SESSION GDMSESSION WAYLAND_DISPLAY DISPLAY \
      XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE \
      ARGVUS_VIRTUALIZATION ARGVUS_LOW_POWER LIBGL_ALWAYS_SOFTWARE WLR_RENDERER_ALLOW_SOFTWARE \
      WLR_NO_HARDWARE_CURSORS AQ_NO_MODIFIERS \
      QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_STYLE \
      XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_SIZE \
      MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT SDL_VIDEODRIVER \
      _JAVA_AWT_WM_NONREPARENTING SAL_USE_VCLPLUGIN YAZI_CONFIG_HOME \
      DBUS_SESSION_BUS_ADDRESS >/dev/null 2>&1 || true
  fi
}

require_systemd() {
  user_systemd_available || {
    warn "systemd --user is not available"
    exit 69
  }
}

systemd_env_value() {
  _name="$1"
  user_systemd_available || return 0
  systemctl --user show-environment 2>/dev/null |
    sed -n "s/^${_name}=//p" |
    tail -n 1
}

adopt_systemd_environment() {
  for _name in WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD; do
    eval "_current=\${${_name}:-}"
    [ -n "$_current" ] && continue
    _value="$(systemd_env_value "$_name")"
    [ -n "$_value" ] || continue
    export "$_name=$_value"
  done
}

wayland_socket_ready() {
  [ -n "${WAYLAND_DISPLAY:-}" ] || return 1
  [ -n "${XDG_RUNTIME_DIR:-}" ] || return 1

  case "$WAYLAND_DISPLAY" in
    /*) _socket="$WAYLAND_DISPLAY" ;;
    *)  _socket="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ;;
  esac

  [ -S "$_socket" ]
}

wait_graphical_runtime() {
  _tries=0
  while [ "$_tries" -lt 50 ]; do
    adopt_systemd_environment
    wayland_socket_ready && return 0
    _tries=$((_tries + 1))
    sleep 0.1
  done
  log "Wayland socket not confirmed before starting ${1:-component}; continuing"
}

start_session() {
  require_systemd
  import_environment
  systemctl --user start graphical-session.target argvus-session.target
  start_sysinfo_if_enabled
}

stop_session() {
  require_systemd
  systemctl --user stop argvus-session.target graphical-session.target
}

restart_session() {
  stop_session || true
  start_session
}

prepare_script() {
  printf '%s\n' "$SYSTEM_CONFIG/scripts/apps/hypr-init.sh"
}

prepare_session() {
  script="$(prepare_script)"
  [ -f "$script" ] || {
    warn "prepare script not found: $script"
    exit 78
  }
  ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG" ARGVUS_CONFIG_HOME="$CONFIG_HOME" \
    sh "$script" --prepare
}

reload_configuration() {
  script="$(prepare_script)"
  [ -f "$script" ] || {
    warn "reload script not found: $script"
    exit 78
  }
  ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG" ARGVUS_CONFIG_HOME="$CONFIG_HOME" \
    sh "$script" --reload-config
}

restart_units() {
  require_systemd
  [ "$#" -gt 0 ] || return 0
  systemctl --user restart "$@"
}

sysinfo_enabled() {
  . "$SYSTEM_CONFIG/scripts/argvus/bootstrap.sh"
  [ "$(sed -n '1p' "$(paths_cache waybar/sysinfo-state)" 2>/dev/null || true)" = "enabled" ]
}

run_waybar() {
  _name="$1"
  _config_rel="waybar/argvus-${_name}.jsonc"
  _style_rel="waybar/argvus-${_name}.css"
  _config="$(paths_config "$_config_rel")"
  _style="$(paths_config "$_style_rel")"
  _system_config_file="$(paths_system_config "$_config_rel")"
  _system_style_file="$(paths_system_config "$_style_rel")"

  if [ ! -f "$_config" ] || [ ! -f "$_style" ]; then
    log "Waybar ${_name} skipped; missing config=${_config} style=${_style}"
    exit 0
  fi

  wait_graphical_runtime "waybar-${_name}"
  log "starting Waybar ${_name}: config=${_config} style=${_style}"

  set +e
  waybar -c "$_config" -s "$_style"
  _status=$?
  set -e

  if [ "$_status" -le 128 ] &&
    { [ "$_config" != "$_system_config_file" ] || [ "$_style" != "$_system_style_file" ]; } &&
    [ -f "$_system_config_file" ] && [ -f "$_system_style_file" ]; then
    log "Waybar ${_name} exited with ${_status}; retrying packaged config"
    exec waybar -c "$_system_config_file" -s "$_system_style_file"
  fi

  exit "$_status"
}

default_wallpaper() {
  for _wallpaper in \
    "$SYSTEM_CONFIG/backgrounds/argvus/default.png" \
    "/usr/share/backgrounds/argvus/default.png"
  do
    [ -f "$_wallpaper" ] || continue
    printf '%s\n' "$_wallpaper"
    return 0
  done
}

low_power_session() {
  [ "${ARGVUS_LOW_POWER:-0}" = "1" ] && return 0

  if have systemd-detect-virt; then
    systemd-detect-virt --vm >/dev/null 2>&1
    return $?
  fi

  return 1
}

run_swaybg_wallpaper() {
  _wallpaper="$1"
  have swaybg || return 1
  log "starting swaybg with ${_wallpaper}"
  exec swaybg -m fill -i "$_wallpaper"
}

run_hyprpaper_wallpaper() {
  _wallpaper="$1"
  have hyprpaper || return 1

  runtime_config="$(hypr_wallpaper_runtime_config "$_wallpaper")"
  log "starting hyprpaper with ${_wallpaper}"

  set +e
  hyprpaper -c "$runtime_config"
  _status=$?
  set -e

  if [ "$_status" -le 128 ] || [ "$_status" -eq 139 ]; then
    log "hyprpaper exited with ${_status}; trying swaybg fallback"
    run_swaybg_wallpaper "$_wallpaper"
  fi

  exit "$_status"
}

run_wallpaper() {
  _wallpaper="${WALLPAPER_PATH:-}"
  if [ -z "$_wallpaper" ] || [ ! -f "$_wallpaper" ]; then
    _fallback="$(default_wallpaper)"
    if [ -n "$_fallback" ]; then
      log "wallpaper path unavailable (${_wallpaper:-empty}); using ${_fallback}"
      _wallpaper="$_fallback"
    else
      log "wallpaper skipped; no valid wallpaper path and no packaged default"
      exit 0
    fi
  fi

  wait_graphical_runtime wallpaper

  if low_power_session; then
    run_swaybg_wallpaper "$_wallpaper" || {
      log "low-power wallpaper requested, but swaybg is unavailable"
    }
  fi

  run_hyprpaper_wallpaper "$_wallpaper" || true
  run_swaybg_wallpaper "$_wallpaper" || true

  log "wallpaper skipped; neither hyprpaper nor swaybg is installed"
  exit 0
}

restart_components() {
  units=""
  for component in "$@"; do
    case "$component" in
      waybar|waybars)
        units="$units argvus-waybar-taskbar.service"
        if sysinfo_enabled; then
          units="$units argvus-waybar-sysinfo.service"
        fi
        ;;
      waybar-taskbar|taskbar)
        units="$units argvus-waybar-taskbar.service"
        ;;
      waybar-sysinfo|sysinfo)
        units="$units argvus-waybar-sysinfo.service"
        ;;
      wallpaper)
        units="$units argvus-wallpaper.service"
        ;;
      hypridle|idle)
        units="$units argvus-hypridle.service"
        ;;
      dunst|notifications)
        units="$units argvus-dunst.service"
        ;;
      shell|quickshell)
        units="$units argvus-shell.service"
        ;;
      snappy|snappy-switcher)
        units="$units argvus-snappy-switcher.service"
        ;;
      clipboard)
        units="$units argvus-clipboard-text.service argvus-clipboard-image.service"
        ;;
      keyboard|keyboard-layout)
        units="$units argvus-keyboard-layout.service"
        ;;
      bluetooth|blueman|blueman-applet)
        units="$units argvus-blueman-applet.service"
        ;;
      polkit|policykit)
        units="$units argvus-polkit.service"
        ;;
      *)
        warn "unknown component: $component"
        exit 64
        ;;
    esac
  done
  # shellcheck disable=SC2086
  restart_units $units
}

start_sysinfo_if_enabled() {
  require_systemd
  import_environment
  if sysinfo_enabled; then
    systemctl --user start argvus-waybar-sysinfo.service
  fi
}

sysinfo_command() {
  case "${1:-}" in
    is-enabled)
      sysinfo_enabled
      ;;
    start-if-enabled)
      start_sysinfo_if_enabled
      ;;
    status)
      if sysinfo_enabled; then
        printf 'enabled\n'
      else
        printf 'disabled\n'
      fi
      ;;
    *)
      warn "unknown sysinfo command: ${1:-empty}"
      exit 64
      ;;
  esac
}

reload_session() {
  require_systemd
  import_environment
  reload_configuration
  restart_components wallpaper hypridle waybar dunst shell snappy-switcher polkit
}

status_session() {
  require_systemd
  systemctl --user status --no-pager argvus-session.target || true
  systemctl --user list-units --no-pager 'argvus-*.service' 'hyprpolkitagent.service' || true
}

logs_session() {
  require_systemd
  if [ "$#" -gt 0 ]; then
    journalctl --user "$@"
  else
    journalctl --user -u argvus-session.target -u 'argvus-*.service' -u hyprpolkitagent.service
  fi
}

run_component() {
  component="${1:-}"
  case "$component" in
    waybar-taskbar)
      have waybar || exit 0
      . "$SYSTEM_CONFIG/scripts/argvus/bootstrap.sh"
      run_waybar taskbar
      ;;
    waybar-sysinfo)
      have waybar || exit 0
      . "$SYSTEM_CONFIG/scripts/argvus/bootstrap.sh"
      run_waybar sysinfo
      ;;
    wallpaper)
      . "$SYSTEM_CONFIG/scripts/argvus/bootstrap.sh"
      run_wallpaper
      ;;
    hypridle)
      have hypridle || exit 0
      . "$SYSTEM_CONFIG/scripts/argvus/bootstrap.sh"
      exec hypridle -c "$(paths_config hypr/hypridle.conf)"
      ;;
    dunst)
      have dunst || exit 0
      . "$SYSTEM_CONFIG/scripts/argvus/bootstrap.sh"
      exec dunst -config "$(paths_config dunst/dunstrc)"
      ;;
    shell)
      have qs || exit 0
      . "$SYSTEM_CONFIG/scripts/argvus/bootstrap.sh"
      mkdir -p "$(paths_cache quickshell)"
      exec qs -c argvus-control-panel
      ;;
    snappy-switcher)
      have snappy-switcher || exit 0
      exec snappy-switcher --daemon
      ;;
    clipboard-text)
      have wl-paste || exit 0
      have cliphist || exit 0
      exec wl-paste --type text --watch cliphist store
      ;;
    clipboard-image)
      have wl-paste || exit 0
      have cliphist || exit 0
      exec wl-paste --type image --watch cliphist store
      ;;
    keyboard-layout)
      script="$SYSTEM_CONFIG/scripts/argvus/keyboard-layout-daemon.sh"
      [ -f "$script" ] || exit 0
      exec sh "$script"
      ;;
    blueman-applet)
      have blueman-applet || exit 0
      exec blueman-applet
      ;;
    *)
      warn "unknown run component: ${component:-empty}"
      exit 64
      ;;
  esac
}

start_polkit() {
  require_systemd
  import_environment
  if unit_exists hyprpolkitagent.service; then
    systemctl --user start hyprpolkitagent.service
    exit 0
  fi
  warn "hyprpolkitagent.service is not installed; install hyprpolkitagent's user unit"
  exit 0
}

stop_polkit() {
  user_systemd_available || exit 0
  if unit_exists hyprpolkitagent.service; then
    systemctl --user stop hyprpolkitagent.service >/dev/null 2>&1 || true
  fi
}

usage() {
  cat <<EOF
Usage: argvus-sessionctl <command> [args]

Commands:
  import-environment  synchronize ARGVUS/Wayland variables into systemd and DBus
  ready               mark the compositor ready and start the ARGVUS session target
  start               start argvus-session.target
  stop                stop argvus-session.target and graphical-session.target
  restart             restart the ARGVUS session target
  reload              re-apply mutable config and restart affected services
  restart <items...>  restart component groups: waybar, wallpaper, dunst, shell, ...
  status              show target and service status
  logs [journal args] show ARGVUS user-unit journal logs
  sysinfo <command>   sysinfo helpers: is-enabled, start-if-enabled, status
EOF
}

case "${1:-}" in
  import-environment)
    import_environment
    ;;
  ready|start)
    start_session
    ;;
  stop)
    stop_session
    ;;
  restart)
    shift
    if [ "$#" -eq 0 ]; then
      restart_session
    else
      restart_components "$@"
    fi
    ;;
  reload)
    reload_session
    ;;
  status)
    status_session
    ;;
  logs)
    shift
    logs_session "$@"
    ;;
  sysinfo)
    shift
    sysinfo_command "$@"
    ;;
  run)
    shift
    run_component "$@"
    ;;
  prepare)
    prepare_session
    ;;
  start-polkit)
    start_polkit
    ;;
  stop-polkit)
    stop_polkit
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    warn "unknown command: $1"
    usage >&2
    exit 64
    ;;
esac
