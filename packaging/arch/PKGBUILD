# Maintainer: William C. Canin
pkgname=argvus-session
pkgver=0.3.0
pkgrel=1
pkgdesc="Session lifecycle and supervision infrastructure for the Argvus desktop."
arch=('any')
url="https://gitlab.com/argvus/argvus-session"
license=('GPL-3.0-only')
depends=('cliphist' 'hyprland' 'jq' 'libnotify' 'socat' 'systemd' 'wl-clipboard')
options=('!debug')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://gitlab.com/argvus/argvus-session/-/archive/v${pkgver}/argvus-session-v${pkgver}.tar.gz"
)
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" PREFIX=/usr install

  install -Dm644 "LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
