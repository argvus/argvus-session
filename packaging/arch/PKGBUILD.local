# Maintainer: William C. Canin
pkgname=argvus-session
pkgver=0.3.0
pkgrel=2
pkgdesc="Session lifecycle and supervision infrastructure for the Argvus desktop."
arch=('any')
url="https://github.com/argvus/argvus-session"
license=('GPL-3.0-only')
depends=('argvus-hyprland' 'cliphist' 'jq' 'libnotify' 'socat' 'systemd' 'wl-clipboard')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" PREFIX=/usr install

  install -Dm644 "LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
