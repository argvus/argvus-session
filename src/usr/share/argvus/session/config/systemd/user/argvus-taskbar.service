[Unit]
Description=ARGVUS taskbar panel
Requires=argvus-bars.service
PartOf=argvus-session.target graphical-session.target
After=argvus-bars.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/argvus sessionctl bar-surface taskbar start
ExecStop=/usr/bin/argvus sessionctl bar-surface taskbar stop
