[Unit]
Description=ARGVUS notification daemon
PartOf=argvus-session.target graphical-session.target
After=argvus-session-prepare.service graphical-session.target
Before=dunst.service
Conflicts=dunst.service

[Service]
Type=simple
ExecStartPre=-/usr/lib/argvus/commands/argvus-notifications theme restore
ExecStart=/usr/lib/argvus/commands/argvus-sessionctl run dunst
ExecStartPost=-/usr/lib/argvus/commands/argvus-notifications dnd restore
Restart=on-failure
RestartSec=2s
