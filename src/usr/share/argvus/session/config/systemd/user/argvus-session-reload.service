[Unit]
Description=Reload ARGVUS compositor configuration
Documentation=man:systemd.service(5)
PartOf=argvus-session.target graphical-session.target
Requires=argvus-session-prepare.service
After=argvus-config.service argvus-session-prepare.service
# No Before= on the desktop components: they do not read the compositor
# configuration, so they start in parallel with this reload.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/argvus sessionctl reload-desktop --login
