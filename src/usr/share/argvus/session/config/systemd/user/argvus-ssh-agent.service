[Unit]
Description=ARGVUS SSH agent
PartOf=argvus-session.target graphical-session.target
After=argvus-session-prepare.service graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh-agent -D -a %t/ssh-agent.socket
ExecStartPost=/usr/bin/systemctl --user set-environment SSH_AUTH_SOCK=%t/ssh-agent.socket
Restart=on-failure
