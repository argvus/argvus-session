[Unit]
Description=Apply ARGVUS night light at session entry
PartOf=argvus-session.target graphical-session.target
Wants=hyprsunset.service
After=argvus-session-prepare.service hyprsunset.service
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=oneshot
ExecStart=/usr/bin/argvus config display night-light apply
Restart=on-failure
RestartSec=1
TimeoutStartSec=15
