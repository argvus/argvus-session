[Unit]
Description=ARGVUS Secret Service provider (gnome-keyring)
PartOf=argvus-session.target graphical-session.target
After=argvus-session-prepare.service graphical-session.target
ConditionPathExists=/usr/bin/gnome-keyring-daemon

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/argvus sessionctl start-secret-service
ExecStop=/usr/bin/argvus sessionctl stop-secret-service
