[Unit]
Description=ARGVUS window bar
Requires=argvus-bars.service
PartOf=argvus-session.target graphical-session.target
After=argvus-bars.service argvus-windows.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/argvus sessionctl bar-surface window-bar start
ExecStop=/usr/bin/argvus sessionctl bar-surface window-bar stop
