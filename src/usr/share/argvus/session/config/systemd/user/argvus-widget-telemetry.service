[Unit]
Description=ARGVUS widget telemetry panel
Requires=argvus-panels.service
PartOf=argvus-session.target graphical-session.target
After=argvus-panels.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/usr/bin/argvus sessionctl widget-telemetry is-enabled
ExecStart=/usr/bin/argvus sessionctl bar-surface widget-telemetry start
ExecStop=/usr/bin/argvus sessionctl bar-surface widget-telemetry stop
