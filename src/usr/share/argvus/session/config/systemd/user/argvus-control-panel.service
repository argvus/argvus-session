[Unit]
Description=ARGVUS control panel
Requires=argvus-panels.service
PartOf=argvus-session.target graphical-session.target
After=argvus-panels.service argvus-session-prepare.service graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/argvus sessionctl bar-surface control-panel start
ExecStop=/usr/bin/argvus sessionctl bar-surface control-panel stop
