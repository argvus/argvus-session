#!/usr/bin/env sh
# shellcheck disable=SC1091
# Control the ARGVUS graphical session lifecycle.

set -eu

SYSTEM_CONFIG="${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}"
CONFIG_HOME="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/argvus"
LOG="$STATE_DIR/session.log"

# shellcheck disable=SC1091
. /usr/share/argvus/lib/i18n.sh

log() {
  mkdir -p "$STATE_DIR"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}

warn() {
  printf 'argvus-sessionctl: %s\n' "$*" >&2
}

have() {
  command -v "$1" >/dev/null 2>&1
}

user_systemd_available() {
  have systemctl && systemctl --user show-environment >/dev/null 2>&1
}

unit_exists() {
  user_systemd_available || return 1
  systemctl --user cat "$1" >/dev/null 2>&1
}

import_environment() {
  export ARGVUS_CONFIG_HOME="$CONFIG_HOME"
  export ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG"
  export XDG_CONFIG_HOME="$CONFIG_HOME"
  ARGVUS_PROJECT_CONFIG_DIRS="$SYSTEM_CONFIG/portal/config:$SYSTEM_CONFIG/appearance/config:$SYSTEM_CONFIG/app-profiles/config:$SYSTEM_CONFIG/terminal/config:$SYSTEM_CONFIG/launcher/config:$SYSTEM_CONFIG/notifications/config:$SYSTEM_CONFIG/network/config:$SYSTEM_CONFIG/control-panel/config:$SYSTEM_CONFIG/taskbar/config:$SYSTEM_CONFIG"
  case ":${XDG_CONFIG_DIRS:-/etc/xdg}:" in
    *":$SYSTEM_CONFIG/portal/config:"*) ;;
    *) export XDG_CONFIG_DIRS="$ARGVUS_PROJECT_CONFIG_DIRS:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
  esac
  export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
  export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"
  export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
  export DESKTOP_SESSION="${DESKTOP_SESSION:-argvus}"
  export GDMSESSION="${GDMSESSION:-argvus}"
  export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
  export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-qt6ct}"
  export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-org.hyprland.style}"

  # A reload launched from a transient user unit may not inherit the
  # compositor environment. Reuse the user manager's known graphical values
  # instead of importing empty variables and making subsequent GUI launches
  # stale or incomplete.
  for _name in WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD DBUS_SESSION_BUS_ADDRESS; do
    eval "_current=\${${_name}:-}"
    [ -n "$_current" ] || {
      _current="$(systemd_env_value "$_name")"
      [ -n "$_current" ] && export "$_name=$_current"
    }
  done

  if user_systemd_available; then
    systemctl --user import-environment \
      ARGVUS_CONFIG_HOME ARGVUS_SYSTEM_CONFIG \
      XDG_CONFIG_HOME XDG_CONFIG_DIRS XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
      XDG_SESSION_TYPE DESKTOP_SESSION GDMSESSION WAYLAND_DISPLAY DISPLAY \
      LANG LC_ALL LC_MESSAGES \
      XDG_CURRENT_DESKTOP XDG_SESSION_CLASS XDG_SESSION_ID XDG_VTNR \
      XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD \
      ARGVUS_VIRTUALIZATION ARGVUS_LOW_POWER LIBGL_ALWAYS_SOFTWARE WLR_RENDERER_ALLOW_SOFTWARE \
      WLR_NO_HARDWARE_CURSORS AQ_NO_MODIFIERS \
      QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_STYLE \
      XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_SIZE \
      MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT SDL_VIDEODRIVER \
      _JAVA_AWT_WM_NONREPARENTING SAL_USE_VCLPLUGIN YAZI_CONFIG_HOME \
      DBUS_SESSION_BUS_ADDRESS >/dev/null 2>&1 || true
  fi

  if have dbus-update-activation-environment; then
    dbus-update-activation-environment --systemd \
      ARGVUS_CONFIG_HOME ARGVUS_SYSTEM_CONFIG \
      XDG_CONFIG_HOME XDG_CONFIG_DIRS XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
      XDG_SESSION_TYPE DESKTOP_SESSION GDMSESSION WAYLAND_DISPLAY DISPLAY \
      LANG LC_ALL LC_MESSAGES \
      XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE \
      ARGVUS_VIRTUALIZATION ARGVUS_LOW_POWER LIBGL_ALWAYS_SOFTWARE WLR_RENDERER_ALLOW_SOFTWARE \
      WLR_NO_HARDWARE_CURSORS AQ_NO_MODIFIERS \
      QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_STYLE \
      XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_SIZE \
      MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT SDL_VIDEODRIVER \
      _JAVA_AWT_WM_NONREPARENTING SAL_USE_VCLPLUGIN YAZI_CONFIG_HOME \
      DBUS_SESSION_BUS_ADDRESS >/dev/null 2>&1 || true
  fi
}

require_systemd() {
  user_systemd_available || {
    warn "$(argvus_tr session error.systemd_unavailable)"
    exit 69
  }
}

systemd_env_value() {
  _name="$1"
  user_systemd_available || return 0
  systemctl --user show-environment 2>/dev/null |
    sed -n "s/^${_name}=//p" |
    tail -n 1
}

adopt_systemd_environment() {
  for _name in WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD; do
    eval "_current=\${${_name}:-}"
    [ -n "$_current" ] && continue
    _value="$(systemd_env_value "$_name")"
    [ -n "$_value" ] || continue
    export "$_name=$_value"
  done
}

wayland_socket_ready() {
  [ -n "${WAYLAND_DISPLAY:-}" ] || return 1
  [ -n "${XDG_RUNTIME_DIR:-}" ] || return 1

  case "$WAYLAND_DISPLAY" in
    /*) _socket="$WAYLAND_DISPLAY" ;;
    *)  _socket="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ;;
  esac

  [ -S "$_socket" ]
}

wait_graphical_runtime() {
  # The socket path can remain while Hyprland is being replaced. A path check
  # alone would let Qt or hypridle connect to a stale endpoint.
  while :; do
    adopt_systemd_environment
    if wayland_socket_ready; then
      if have hyprctl && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        timeout 1s hyprctl instances >/dev/null 2>&1 || {
          sleep 0.1
          continue
        }
      fi
      return 0
    fi
    sleep 0.1
  done
}

start_session() {
  _start_mode="${1:-start}"
  require_systemd
  import_environment

  # Hyprland can invoke `ready` while an older ARGVUS target is still active
  # (systemd --user survives logout/login).  Reusing that target also reuses
  # the previous HYPRLAND_INSTANCE_SIGNATURE, which disables Waybar's
  # hyprland/* modules against the stale IPC socket.  Recreate the target only
  # after the compositor reports ready, so its services inherit the current
  # Wayland/Hyprland environment.
  if [ "$_start_mode" = ready ]; then
    systemctl --user stop argvus-session.target >/dev/null 2>&1 || true
  fi

  systemctl --user start graphical-session.target argvus-session.target
  if [ "$_start_mode" = ready ]; then
    # The handoff overlay is intentionally independent of desktop components:
    # it remains mapped until Hyprland reaches its existing ready bridge, then
    # systemd sends SIGTERM through the splash's normal fade-out path.
    systemctl --user stop argvus-session-loading.service >/dev/null 2>&1 || true
    log "stopped session loading overlay after graphical readiness"
  fi
  start_widget_telemetry_if_enabled
}

stop_session() {
  require_systemd
  systemctl --user stop argvus-session.target graphical-session.target
}

restart_session() {
  stop_session || true
  start_session
}

prepare_script() {
  printf '%s\n' "$SYSTEM_CONFIG/session/sh/hypr-init.sh"
}

prepare_session() {
  # argvus-session-prepare.service already Requires/After argvus-config.service.
  # Starting it again here would make this process wait on its own transaction.
  require_systemd
  script="$(prepare_script)"
  [ -f "$script" ] || {
    warn "$(argvus_tr session error.prepare_missing "path=$script")"
    exit 78
  }
  ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG" ARGVUS_CONFIG_HOME="$CONFIG_HOME" \
    sh "$script" --prepare
}

reload_configuration() {
  require_systemd
  import_environment
  # Starting the active config service with --wait can leave the Hyprland
  # exec child blocked indefinitely while systemd is processing the same
  # transaction.  reload-or-restart handles both inactive and active units
  # without nesting a wait on the canonical service transaction.
  timeout 30s systemctl --user reload-or-restart argvus-config.service || {
    _status=$?
    warn "canonical configuration reload failed (status ${_status})"
    return "$_status"
  }
}

reload_runtime_configuration() {
  script="$(prepare_script)"
  [ -f "$script" ] || {
    warn "$(argvus_tr session error.reload_missing "path=$script")"
    return 78
  }
  # A theme transaction already committed and projected modular configuration while it
  # owns theme-switch.lock. Reuse the same runtime half as SUPER+Shift+R,
  # including hyprctl reload and Rofi synchronization, without re-entering
  # argvus-config project and acquiring the lock in the opposite order.
  ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG" ARGVUS_CONFIG_HOME="$CONFIG_HOME" \
    sh "$script" --reload-config
}

reload_desktop() {
  require_systemd
  import_environment
  script="$(prepare_script)"
  [ -f "$script" ] || {
    warn "$(argvus_tr session error.reload_missing "path=$script")"
    return 78
  }
  # argvus-session.target owns the Waybar and Quickshell lifecycle through
  # PartOf/Wants. This command performs the compositor half once; restarting
  # the target then stops and starts each surface exactly once.
  ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG" ARGVUS_CONFIG_HOME="$CONFIG_HOME" \
    timeout 30s sh "$script" --reload-config
}

reload_splash_pid_file() {
  printf '%s/argvus-theme-splash.pid\n' "${XDG_RUNTIME_DIR:-/tmp}"
}

reload_splash_active() {
  _pid_file="$(reload_splash_pid_file)"
  _pid="$(sed -n '1p' "$_pid_file" 2>/dev/null || true)"
  case "$_pid" in
    ''|*[!0-9]*) rm -f "$_pid_file"; return 1 ;;
  esac
  if kill -0 "$_pid" 2>/dev/null; then
    return 0
  fi
  rm -f "$_pid_file"
  return 1
}

reload_splash_start() {
  reload_splash_active && return 0
  _splash_bin="${ARGVUS_THEME_SPLASH_BIN:-/usr/lib/argvus/theme-splash/splash}"
  [ -x "$_splash_bin" ] || return 0
  # The splash is an optional cover, not a reason to block a config reload
  # while the compositor is still starting (or has already stopped). Keep the
  # handshake bounded; the actual runtime consumers still report their own
  # readiness/failure below.
  _runtime_wait=0
  while :; do
    adopt_systemd_environment
    if wayland_socket_ready; then
      if have hyprctl && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        timeout 1s hyprctl instances >/dev/null 2>&1 || {
          sleep 0.1
          _runtime_wait=$((_runtime_wait + 1))
          [ "$_runtime_wait" -ge 50 ] && return 0
          continue
        }
      fi
      break
    fi
    [ "$_runtime_wait" -ge 50 ] && return 0
    sleep 0.1
    _runtime_wait=$((_runtime_wait + 1))
  done
  _theme="$(argvus-config get /appearance/theme --effective --raw 2>/dev/null || true)"
  [ -n "$_theme" ] || _theme="argvus-dark"
  _ready_file="${XDG_RUNTIME_DIR:-/tmp}/argvus-theme-splash-ready.$$"
  rm -f "$_ready_file"
  "$_splash_bin" --theme "$_theme" --ready-file "$_ready_file" &
  _pid=$!
  _wait=0
  while [ ! -s "$_ready_file" ] && kill -0 "$_pid" 2>/dev/null; do
    [ "$_wait" -ge 40 ] && break
    sleep 0.05
    _wait=$((_wait + 1))
  done
  _ready=0
  [ -s "$_ready_file" ] && _ready=1
  rm -f "$_ready_file"
  if [ "$_ready" -ne 1 ]; then
    kill -TERM "$_pid" 2>/dev/null || true
    wait "$_pid" 2>/dev/null || true
    return 0
  fi
  printf '%s\n' "$_pid" >"$(reload_splash_pid_file)"
}

reload_splash_stop() {
  _pid_file="$(reload_splash_pid_file)"
  _pid="$(sed -n '1p' "$_pid_file" 2>/dev/null || true)"
  rm -f "$_pid_file"
  case "$_pid" in
    ''|*[!0-9]*) return 0 ;;
  esac
  kill -TERM "$_pid" 2>/dev/null || true
  wait "$_pid" 2>/dev/null || true
}

apply_config_runtime() {
  require_systemd
  import_environment
  _manifest="$STATE_DIR/config-projection.json"
  _has_reload_targets=0
  if [ -f "$_manifest" ] && grep -q '"reload_targets"[[:space:]]*:' "$_manifest"; then
    _has_reload_targets=1
  fi
  if [ "$_has_reload_targets" -eq 1 ]; then
    _target_enabled() {
      _target="$1"
      grep -Eq "\"${_target}\"[[:space:]]*:[[:space:]]*true" "$_manifest"
    }

    _overlay_owner=0
    if _target_enabled hyprland || _target_enabled wallpaper ||
      _target_enabled taskbar || _target_enabled widget_telemetry ||
      _target_enabled control_panel || _target_enabled notifications ||
      _target_enabled snappy_switcher || _target_enabled polkit; then
      if ! reload_splash_active; then
        reload_splash_start
        reload_splash_active && _overlay_owner=1 || true
      fi
    fi

    _status=0
    if _target_enabled hyprland; then
      reload_runtime_configuration || _status=$?
    fi
    if [ "$_status" -eq 0 ] && _target_enabled wallpaper; then
      restart_components wallpaper || _status=$?
    fi
    if [ "$_status" -eq 0 ] && _target_enabled taskbar; then
      restart_components taskbar || _status=$?
    fi
    if [ "$_status" -eq 0 ] && _target_enabled widget_telemetry; then
      restart_components widget-telemetry || _status=$?
    fi
    if [ "$_status" -eq 0 ] && _target_enabled control_panel; then
      restart_components control-panel || _status=$?
    fi
    if [ "$_status" -eq 0 ] && _target_enabled notifications; then
      restart_components dunst || _status=$?
    fi
    if [ "$_status" -eq 0 ] && _target_enabled snappy_switcher; then
      restart_components snappy-switcher || _status=$?
    fi
    if [ "$_status" -eq 0 ] && _target_enabled polkit; then
      restart_components polkit || _status=$?
    fi
    if [ "$_status" -eq 0 ] && _target_enabled hypridle; then
      restart_components hypridle || _status=$?
    fi
    [ "$_overlay_owner" -eq 1 ] && reload_splash_stop
    return "$_status"
  fi
  _reload_plan="full"
  if [ -f "$_manifest" ]; then
    _reload_plan="$(sed -n 's/.*\"reload_plan\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p' "$_manifest" | tail -n 1)"
    [ -n "$_reload_plan" ] || _reload_plan="full"
  fi
  case "$_reload_plan" in
    full)
      reload_runtime_configuration || return $?
      restart_components wallpaper hypridle waybar dunst control-panel snappy-switcher polkit
      ;;
    hyprland)
      script="$(prepare_script)"
      [ -f "$script" ] || return 78
      ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG" ARGVUS_CONFIG_HOME="$CONFIG_HOME" \
        sh "$script" --reload-config
      ;;
    hypridle)
      restart_components hypridle
      ;;
    none)
      ;;
    *)
      warn "unknown configuration reload plan: $_reload_plan"
      return 65
      ;;
  esac
}

reload_config_transaction() {
  require_systemd
  import_environment
  ARGVUS_CONFIG_SERVICE=1 ARGVUS_CONFIG_HOME="$CONFIG_HOME" \
    ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG" argvus-config project
  apply_config_runtime
}

restart_units() {
  require_systemd
  [ "$#" -gt 0 ] || return 0
  systemctl --user restart "$@"
}

widget_telemetry_enabled() {
  . "$SYSTEM_CONFIG/session/sh/bootstrap.sh"
  _state_file="$(paths_cache waybar/widget-telemetry-state)"
  _legacy_desktop_state_file="$(paths_cache waybar/desktop-telemetry-state)"
  _legacy_state_file="$(paths_cache waybar/sysinfo-state)"
  if [ -f "$_state_file" ]; then
    _state="$(sed -n '1p' "$_state_file" 2>/dev/null || true)"
  elif [ -f "$_legacy_desktop_state_file" ]; then
    _state="$(sed -n '1p' "$_legacy_desktop_state_file" 2>/dev/null || true)"
  else
    _state="$(sed -n '1p' "$_legacy_state_file" 2>/dev/null || true)"
  fi
  [ "$_state" = "enabled" ]
}

resolve_waybar_file() {
  _canonical_rel="$1"
  _legacy_rel="${2:-}"
  for _resolver in paths_override_config paths_user_config paths_generated_config; do
    _candidate="$($_resolver "$_canonical_rel")"
    if [ -e "$_candidate" ] || [ -L "$_candidate" ]; then
      printf '%s\n' "$_candidate"
      return 0
    fi
    [ -n "$_legacy_rel" ] || continue
    _candidate="$($_resolver "$_legacy_rel")"
    if [ -e "$_candidate" ] || [ -L "$_candidate" ]; then
      printf '%s\n' "$_candidate"
      return 0
    fi
  done
  paths_system_config "$_canonical_rel"
}

run_waybar() {
  _name="$1"
  _legacy_name="${2:-}"
  case "$_name" in
    taskbar)
      _config_rel="taskbar/config/argvus-taskbar.jsonc"
      _style_rel="taskbar/config/argvus-taskbar.css"
      ;;
    widget-telemetry)
      _config_rel="widget-telemetry/config/argvus-widget-telemetry.jsonc"
      _style_rel="widget-telemetry/config/argvus-widget-telemetry.css"
      ;;
    *)
      _config_rel="${_name}/config/argvus-${_name}.jsonc"
      _style_rel="${_name}/config/argvus-${_name}.css"
      ;;
  esac
  _legacy_config_rel="waybar/argvus-${_name}.jsonc"
  _legacy_style_rel="waybar/argvus-${_name}.css"
  _config="$(resolve_waybar_file "$_config_rel" "$_legacy_config_rel")"
  _style="$(resolve_waybar_file "$_style_rel" "$_legacy_style_rel")"
  _system_config_file="$(paths_system_config "$_config_rel")"
  _system_style_file="$(paths_system_config "$_style_rel")"

  if [ ! -f "$_config" ] || [ ! -f "$_style" ]; then
    log "Waybar ${_name} skipped; missing config=${_config} style=${_style}"
    exit 0
  fi

  wait_graphical_runtime "waybar-${_name}"
  log "starting Waybar ${_name}: config=${_config} style=${_style}"

  set +e
  waybar -c "$_config" -s "$_style"
  _status=$?
  set -e

  if [ "$_status" -le 128 ] &&
    { [ "$_config" != "$_system_config_file" ] || [ "$_style" != "$_system_style_file" ]; } &&
    [ -f "$_system_config_file" ] && [ -f "$_system_style_file" ]; then
    log "Waybar ${_name} exited with ${_status}; retrying packaged config"
    exec waybar -c "$_system_config_file" -s "$_system_style_file"
  fi

  exit "$_status"
}

default_wallpaper() {
  for _wallpaper in \
    "$SYSTEM_CONFIG/backgrounds/argvus/argvus-dark.jxl" \
    "/usr/share/backgrounds/argvus/argvus-dark.jxl"
  do
    [ -f "$_wallpaper" ] || continue
    printf '%s\n' "$_wallpaper"
    return 0
  done
}

low_power_session() {
  [ "${ARGVUS_LOW_POWER:-0}" = "1" ] && return 0

  if have systemd-detect-virt; then
    systemd-detect-virt --vm >/dev/null 2>&1
    return $?
  fi

  return 1
}

run_swaybg_wallpaper() {
  _wallpaper="$1"
  have swaybg || return 1
  log "starting swaybg with ${_wallpaper}"
  exec swaybg -m fill -i "$_wallpaper"
}

run_hyprpaper_wallpaper() {
  _wallpaper="$1"
  have hyprpaper || return 1

  runtime_config="$(hypr_wallpaper_runtime_config "$_wallpaper")"
  log "starting hyprpaper with ${_wallpaper}"

  set +e
  hyprpaper -c "$runtime_config"
  _status=$?
  set -e

  if [ "$_status" -le 128 ] || [ "$_status" -eq 139 ]; then
    log "hyprpaper exited with ${_status}; trying swaybg fallback"
    run_swaybg_wallpaper "$_wallpaper"
  fi

  exit "$_status"
}

persisted_wallpaper() {
  _custom_state="$CONFIG_HOME/argvus/.wallpaper-custom"
  if [ -f "$_custom_state" ]; then
    sed -n '1p' "$_custom_state"
    return 0
  fi

  # The canonical document is authoritative after argvus-config projection.
  # Keep the file-based fallback below for older installations and custom
  # layouts, but do not let a stale generated hyprpaper.conf win over a newer
  # theme wallpaper.
  if have argvus-config; then
    _canonical_wallpaper="$(
      ARGVUS_CONFIG_HOME="$CONFIG_HOME" argvus-config get /appearance/wallpaper --raw 2>/dev/null || true
    )"
    if [ -n "$_canonical_wallpaper" ] && [ -f "$_canonical_wallpaper" ]; then
      printf '%s\n' "$_canonical_wallpaper"
      return 0
    fi
  fi

  # Compatibility fallback for selections made before the explicit state
  # marker existed. The managed ARGVUS config is the durable source used by
  # both the picker and the Control Center.
  _config="$CONFIG_HOME/argvus/hypr/hyprpaper.conf"
  [ -f "$_config" ] || _config="$CONFIG_HOME/hypr/hyprpaper.conf"
  [ -f "$_config" ] || return 1
  sed -n \
    -e "s|^[[:space:]]*path[[:space:]]*=[[:space:]]*~|$HOME|p" \
    -e 's|^[[:space:]]*path[[:space:]]*=[[:space:]]*\(/.*\)|\1|p' \
    "$_config" | head -n1
}

run_wallpaper() {
  _wallpaper="$(persisted_wallpaper 2>/dev/null || true)"
  [ -n "$_wallpaper" ] || _wallpaper="${WALLPAPER_PATH:-}"
  if [ -z "$_wallpaper" ] || [ ! -f "$_wallpaper" ]; then
    _fallback="$(default_wallpaper)"
    if [ -n "$_fallback" ]; then
      log "wallpaper path unavailable (${_wallpaper:-empty}); using ${_fallback}"
      _wallpaper="$_fallback"
    else
      log "wallpaper skipped; no valid wallpaper path and no packaged default"
      exit 0
    fi
  fi

  wait_graphical_runtime wallpaper

  # Official wallpapers use JPEG XL. Prefer hyprpaper for this format before
  # the low-power swaybg path, whose codec support varies by build.
  case "$_wallpaper" in
    *.jxl)
      run_hyprpaper_wallpaper "$_wallpaper" || run_swaybg_wallpaper "$_wallpaper" || true
      return 0
      ;;
  esac

  if low_power_session; then
    run_swaybg_wallpaper "$_wallpaper" || {
      log "low-power wallpaper requested, but swaybg is unavailable"
    }
  fi

  run_hyprpaper_wallpaper "$_wallpaper" || true
  run_swaybg_wallpaper "$_wallpaper" || true

  log "wallpaper skipped; neither hyprpaper nor swaybg is installed"
  exit 0
}

restart_components() {
  units=""
  for component in "$@"; do
    case "$component" in
      waybar|waybars)
        units="$units argvus-taskbar.service"
        if widget_telemetry_enabled; then
          units="$units argvus-widget-telemetry.service"
        fi
        ;;
      waybar-taskbar|taskbar)
        units="$units argvus-taskbar.service"
        ;;
      widget-telemetry|desktop-telemetry|telemetry|waybar-sysinfo|sysinfo)
        units="$units argvus-widget-telemetry.service"
        ;;
      wallpaper)
        units="$units argvus-wallpaper.service"
        ;;
      hypridle|idle)
        units="$units argvus-hypridle.service"
        ;;
      dunst|notifications)
        units="$units argvus-dunst.service"
        ;;
      control-panel|shell|quickshell)
        units="$units argvus-control-panel.service"
        ;;
      snappy|snappy-switcher)
        units="$units argvus-snappy-switcher.service"
        ;;
      clipboard)
        units="$units argvus-clipboard-text.service argvus-clipboard-image.service"
        ;;
      keyboard|keyboard-layout)
        units="$units argvus-keyboard-layout.service"
        ;;
      bluetooth|blueman|blueman-applet)
        units="$units argvus-blueman-applet.service"
        ;;
      polkit|policykit)
        units="$units argvus-polkit.service"
        ;;
      *)
        warn "$(argvus_tr session error.unknown_component "component=$component")"
        exit 64
        ;;
    esac
  done
  # shellcheck disable=SC2086
  restart_units $units
}

start_widget_telemetry_if_enabled() {
  require_systemd
  import_environment
  if widget_telemetry_enabled; then
    systemctl --user start argvus-widget-telemetry.service
  fi
}

widget_telemetry_command() {
  case "${1:-}" in
    is-enabled)
      widget_telemetry_enabled
      ;;
    start-if-enabled)
      start_widget_telemetry_if_enabled
      ;;
    status)
      if widget_telemetry_enabled; then
        printf 'enabled\n'
      else
        printf 'disabled\n'
      fi
      ;;
    *)
      warn "$(argvus_tr session error.unknown_widget_command "command=${1:-empty}")"
      exit 64
      ;;
  esac
}

reload_session() {
  require_systemd
  import_environment
  reload_configuration
}

status_session() {
  require_systemd
  systemctl --user status --no-pager argvus-session.target || true
  systemctl --user list-units --no-pager 'argvus-*.service' 'hyprpolkitagent.service' || true
}

logs_session() {
  require_systemd
  if [ "$#" -gt 0 ]; then
    journalctl --user "$@"
  else
    journalctl --user -u argvus-session.target -u 'argvus-*.service' -u hyprpolkitagent.service
  fi
}

run_component() {
  component="${1:-}"
  case "$component" in
    taskbar|waybar-taskbar)
      have waybar || exit 0
      . "$SYSTEM_CONFIG/session/sh/bootstrap.sh"
      run_waybar taskbar
      ;;
    widget-telemetry|desktop-telemetry|waybar-sysinfo)
      have waybar || exit 0
      . "$SYSTEM_CONFIG/session/sh/bootstrap.sh"
      run_waybar widget-telemetry sysinfo
      ;;
    wallpaper)
      . "$SYSTEM_CONFIG/session/sh/bootstrap.sh"
      run_wallpaper
      ;;
    hypridle)
      have hypridle || exit 0
      KEEP_AWAKE_FILE="${ARGVUS_CONFIG_HOME}/argvus/.keep-awake"
      if [ -f "$KEEP_AWAKE_FILE" ] && [ "$(sed -n '1p' "$KEEP_AWAKE_FILE")" = enabled ]; then
        exit 0
      fi
      wait_graphical_runtime hypridle
      . "$SYSTEM_CONFIG/session/sh/bootstrap.sh"
      export ARGVUS_MUTABLE_CONFIG=1
      exec hypridle -c "$(paths_config power/config/hypridle.conf)"
      ;;
    dunst)
      have dunst || exit 0
      . "$SYSTEM_CONFIG/session/sh/bootstrap.sh"
      exec dunst -config "$(paths_config notifications/config/dunstrc)"
      ;;
    control-panel|shell|quickshell)
      control_panel_state="$CONFIG_HOME/argvus/state/control-panel"
      if [ -r "$control_panel_state" ] && [ "$(sed -n '1p' "$control_panel_state")" = disabled ]; then
        exit 0
      fi
      have qs || exit 0
      wait_graphical_runtime control-panel
      . "$SYSTEM_CONFIG/session/sh/bootstrap.sh"
      mkdir -p "$(paths_cache quickshell)"
      exec qs -c argvus-control-panel
      ;;
    snappy-switcher)
      have snappy-switcher || exit 0
      exec snappy-switcher --daemon
      ;;
    clipboard-text)
      have wl-paste || exit 0
      have cliphist || exit 0
      exec wl-paste --type text --watch cliphist store
      ;;
    clipboard-image)
      have wl-paste || exit 0
      have cliphist || exit 0
      exec wl-paste --type image --watch cliphist store
      ;;
    keyboard-layout)
      script="$SYSTEM_CONFIG/session/sh/keyboard-layout-daemon.sh"
      [ -f "$script" ] || exit 0
      exec sh "$script"
      ;;
    blueman-applet)
      have blueman-applet || exit 0
      exec blueman-applet
      ;;
    *)
      warn "$(argvus_tr session error.unknown_run_component "component=${component:-empty}")"
      exit 64
      ;;
  esac
}

start_polkit() {
  require_systemd
  import_environment
  if unit_exists hyprpolkitagent.service; then
    systemctl --user start hyprpolkitagent.service
    exit 0
  fi
  warn "$(argvus_tr session error.polkit_missing)"
  exit 0
}

stop_polkit() {
  user_systemd_available || exit 0
  if unit_exists hyprpolkitagent.service; then
    systemctl --user stop hyprpolkitagent.service >/dev/null 2>&1 || true
  fi
}

usage() {
  argvus_tr session usage.sessionctl
  argvus_tr session usage.commands
  argvus_tr session usage.import_environment
  argvus_tr session usage.ready
  argvus_tr session usage.start
  argvus_tr session usage.stop
  argvus_tr session usage.restart
  argvus_tr session usage.reload
  argvus_tr session usage.restart_items
  argvus_tr session usage.status
  argvus_tr session usage.logs
  argvus_tr session usage.widget_telemetry
  argvus_tr session usage.widget_telemetry_help
}

case "${1:-}" in
  import-environment)
    import_environment
    ;;
  ready)
    start_session ready
    ;;
  start)
    start_session start
    ;;
  stop)
    stop_session
    ;;
  restart)
    shift
    if [ "$#" -eq 0 ]; then
      restart_session
    else
      restart_components "$@"
    fi
    ;;
  reload)
    reload_session
    ;;
  reload-desktop)
    reload_desktop
    ;;
  apply-config-runtime)
    apply_config_runtime
    ;;
  reload-config-transaction)
    reload_config_transaction
    ;;
  status)
    status_session
    ;;
  logs)
    shift
    logs_session "$@"
    ;;
  widget-telemetry|desktop-telemetry|sysinfo)
    shift
    widget_telemetry_command "$@"
    ;;
  run)
    shift
    run_component "$@"
    ;;
  prepare)
    prepare_session
    ;;
  start-polkit)
    start_polkit
    ;;
  stop-polkit)
    stop_polkit
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
  warn "$(argvus_tr session error.unknown_command "command=$1")"
    usage >&2
    exit 64
    ;;
esac
