#!/usr/bin/env sh

# Attach the Wayland backend of the single ARGVUS session spinner as soon as
# the user compositor publishes its socket. The native DRM backend covers the
# preceding VT handoff; this process keeps the same visual spinner alive while
# user services become ready.
set -eu

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

socket_paths() {
  _preferred=''
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    case "$WAYLAND_DISPLAY" in
      /*) _candidate="$WAYLAND_DISPLAY" ;;
      *) _candidate="$RUNTIME_DIR/$WAYLAND_DISPLAY" ;;
    esac
    [ -S "$_candidate" ] && {
      printf '%s\n' "$_candidate"
      _preferred="$_candidate"
    }
  fi
  for _candidate in "$RUNTIME_DIR"/wayland-*; do
    [ -S "$_candidate" ] || continue
    [ "$_candidate" = "$_preferred" ] && continue
    printf '%s\n' "$_candidate"
  done
}

while :; do
  _found_socket=0
  for _socket in $(socket_paths 2>/dev/null); do
    _found_socket=1
    export WAYLAND_DISPLAY="${_socket##*/}"
    _accent_file="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/argvus/.accent-color"
    _theme_file="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/argvus/.active-theme"
    _theme="argvus-dark-aether"
    if [ -s "$_theme_file" ]; then
      _theme="$(sed -n '1{s/\r$//;s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$_theme_file")"
      [ -n "$_theme" ] || _theme="argvus-dark-aether"
    fi
    _accent=""
    if [ -s "$_accent_file" ]; then
      _accent="$(sed -n '1{s/\r$//;s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$_accent_file")"
    fi
    case "$_accent" in
      \#*) _accent="${_accent#\#}" ;;
    esac
    case "$_accent" in
      ??????)
        case "$_accent" in
          *[!0-9A-Fa-f]*) _accent='' ;;
          *) _accent="#$_accent" ;;
        esac
        ;;
      *) _accent='' ;;
    esac
    if [ -n "$_accent" ]; then
      if /usr/lib/argvus/theme-splash/splash --session-handoff --spinner-only --theme "$_theme" --accent "$_accent"; then
        exit 0
      fi
    elif /usr/lib/argvus/theme-splash/splash --session-handoff --spinner-only --theme "$_theme"; then
      exit 0
    fi
  done

  # A persistent systemd --user manager can retain a stale WAYLAND_DISPLAY
  # from the preceding session. A socket path alone does not prove that a
  # compositor is accepting clients, so try every available socket and retry
  # until the new Hyprland socket can actually host the splash.
  if [ "$_found_socket" = 1 ]; then
    sleep 0.1
  else
    sleep 0.05
  fi
done
