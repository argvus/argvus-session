#!/usr/bin/env sh
# Argvus Wayland session wrapper.

set -eu

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/argvus"
LOG="$STATE_DIR/session.log"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
SYSTEM_CONFIG="${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}"
mkdir -p "$STATE_DIR"

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}

# Append the greeter's pre-login log (written by argvus-greeter-session) to the
# user's session.log. The greeter truncates this file at each run, so it is
# not removed here: the sticky /run/argvus-greeter directory forbids deleting
# files owned by the greeter user.
GREETER_LOG="/run/argvus-greeter/session.log"
if [ -s "$GREETER_LOG" ]; then
  {
    printf '%s\n' "--- greeter (pre-login) ---"
    cat "$GREETER_LOG"
    printf '%s\n' "--- end greeter ---"
  } >> "$LOG" 2>/dev/null || true
fi

log "running argvus-session"

# Ensure PATH includes standard system directories for subprocess discovery.
# The login manager (e.g., greetd with source_profile=false) may not export PATH
# or may provide only a partial PATH, breaking utilities such as hyprland-dialog
# that Hyprland requires at startup.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin${PATH:+:$PATH}"

export XDG_CONFIG_HOME="$CONFIG_HOME"
case ":${XDG_CONFIG_DIRS:-/etc/xdg}:" in
  *":$SYSTEM_CONFIG:") ;;
  *) export XDG_CONFIG_DIRS="$SYSTEM_CONFIG:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
esac
export ARGVUS_SYSTEM_CONFIG="$SYSTEM_CONFIG"
export ARGVUS_CONFIG_HOME="$CONFIG_HOME"

if command -v argvus-sessionctl >/dev/null 2>&1; then
  argvus-sessionctl import-environment >/dev/null 2>&1 || true
fi

log "executing argvus-start"
exec argvus-start
