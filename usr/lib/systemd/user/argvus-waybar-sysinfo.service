[Unit]
Description=ARGVUS sysinfo panel
PartOf=argvus-session.target graphical-session.target
After=argvus-session-prepare.service graphical-session.target

[Service]
Type=simple
ExecCondition=/usr/bin/argvus-sessionctl sysinfo is-enabled
ExecStart=/usr/bin/argvus-sessionctl run waybar-sysinfo
Restart=on-failure
RestartSec=2s
